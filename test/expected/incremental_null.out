SELECT ddsketch_add('flags 0 count 1 alpha 0.010000 zero_count 0 maxbuckets 100 buckets 1 0 (0, 1)'::ddsketch, ARRAY[2.0, 4.0]::double precision[], NULL::double precision, 100);
