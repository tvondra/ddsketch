-- NULL elements are not allowed, NULL sketch
SELECT ddsketch_add(NULL::ddsketch, ARRAY[NULL]::double precision[], 0.05, 1024);
ERROR:  NULL not allowed as an element
SELECT ddsketch_add(NULL::ddsketch, ARRAY[1.0, NULL, 2.0]::double precision[], 0.05, 1024);
ERROR:  NULL not allowed as an element
-- NULL elements are not allowed, existing sketch
SELECT ddsketch_add('flags 0 count 1 alpha 0.010000 zero_count 0 maxbuckets 100 buckets 1 0 (0, 1)'::ddsketch, ARRAY[NULL]::double precision[], 0.01, 100);
ERROR:  NULL not allowed as an element
SELECT ddsketch_add('flags 0 count 1 alpha 0.010000 zero_count 0 maxbuckets 100 buckets 1 0 (0, 1)'::ddsketch, ARRAY[2.0, NULL]::double precision[], NULL::double precision, NULL::int);
ERROR:  NULL not allowed as an element
